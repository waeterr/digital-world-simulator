{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS - Digital World Simulator - TypeScript Learning Project",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @nexus/server",
    "dev:web": "npm run dev -w @nexus/web",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "typescript",
    "learning",
    "simulation",
    "game"
  ],
  "author": "",
  "license": "MIT"
}
